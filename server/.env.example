# Local dev default (SQLite file, no setup needed):
DATABASE_URL=sqlite:///./sinulead.db

# Prod (swap this in, nothing else changes):
# DATABASE_URL=postgresql+psycopg2://sinulead:PASSWORD@localhost:5432/sinulead

JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Signup OTP delivery (app/otp.py). All optional -- leave SMTP_HOST unset
# and OTP codes just get printed to this server's console instead of
# emailed. These now live only here, server-side; the desktop client no
# longer needs or reads any SMTP settings.
#
# For Gmail specifically:
#   1. Turn on 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password (NOT your normal Gmail password):
#      https://myaccount.google.com/apppasswords
#   3. Use that 16-character App Password below, not your real password.
#   NOTE: if you're reusing the app's Gmail account, generate a *new* App
#   Password here -- the one from the old client/.env was distributed with
#   the desktop app and must be treated as compromised/revoked, not reused.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sinuleadph@gmail.com
SMTP_PASSWORD=
SMTP_FROM=sinuleadph@gmail.com

# Set to false to disable STARTTLS. Leave this alone unless you know you need to.
# SMTP_TLS=true
